# ==============================================================================
# COURAGE LIBRARY — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Target Supabase Project: couragelibrary-next (105 PostgreSQL Base Tables)
# Production URL: https://couragelibrary-next.vercel.app/
#
# IMPORTANT SECURITY RULES:
# 1. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser client bundle.
# 2. Variables WITHOUT NEXT_PUBLIC_ (e.g. SUPABASE_SERVICE_ROLE_KEY) are SERVER-ONLY secrets.
# 3. NEVER commit real secret values, passwords, or service-role keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC / CLIENT-SAFE ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------

# Public URL of your Supabase project instance (couragelibrary-next).
# Safe for client-side exposure.
# Obtain from: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Anonymous / Publishable Key for Supabase API requests and auth SSR.
# Safe for client-side exposure.
# Obtain from: Supabase Dashboard -> Project Settings -> API -> anon / publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Alias for NEXT_PUBLIC_SUPABASE_ANON_KEY supported by config/env.ts
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Canonical base URL of the deployed application used for auth callbacks and SEO metadata.
# Safe for client-side exposure.
# Development: http://localhost:3000 | Production: https://couragelibrary-next.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY / SECRET ENVIRONMENT VARIABLES (CRITICAL)
# ------------------------------------------------------------------------------

# Privileged Supabase Service-Role Secret Key for server-side administrative execution.
# MUST REMAIN SERVER-ONLY. DO NOT EXPOSE TO CLIENT BUNDLES OR NEXT_PUBLIC_ VARIABLES.
# Obtain from: Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 3. RUNTIME / OPTIONAL CONFIGURATION
# ------------------------------------------------------------------------------

# Set automatically by Next.js and Vercel runtime (development | production | test)
NODE_ENV=production
