{
  "$comment": "UX-1a contrast register: every text/background (and non-text) pair the design system uses. Read by the preview page (live values) and scripts/test_design_ratchet.cjs (offline, from app/globals.css). kind: text = 4.5:1, large = 3:1 (>=24px or >=18.66px bold), nontext = 3:1 (UI boundaries, focus, icons), decorative = no requirement (must never carry text), disabled = exempt (WCAG 1.4.3).",
  "pairs": [
    { "use": "Body text", "fg": "ink-900", "bg": "surface", "kind": "text" },
    { "use": "Body text on page background", "fg": "ink-900", "bg": "ink-50", "kind": "text" },
    { "use": "Secondary text", "fg": "ink-600", "bg": "surface", "kind": "text" },
    { "use": "Secondary text on page background", "fg": "ink-600", "bg": "ink-50", "kind": "text" },
    { "use": "Secondary text on sunken surface (table header, segmented tabs)", "fg": "ink-600", "bg": "ink-100", "kind": "text" },
    { "use": "Muted text, placeholder", "fg": "ink-500", "bg": "surface", "kind": "text" },
    { "use": "Muted text on page background", "fg": "ink-500", "bg": "ink-50", "kind": "text" },
    { "use": "Link, primary text", "fg": "primary-600", "bg": "surface", "kind": "text" },
    { "use": "Link on page background", "fg": "primary-600", "bg": "ink-50", "kind": "text" },
    { "use": "Ghost button, selected tab, hovered link", "fg": "primary-700", "bg": "surface", "kind": "text" },
    { "use": "Primary button", "fg": "white", "bg": "primary-600", "kind": "text" },
    { "use": "Primary button hover", "fg": "white", "bg": "primary-700", "kind": "text" },
    { "use": "Primary button pressed", "fg": "white", "bg": "primary-800", "kind": "text" },
    { "use": "Ghost button hover, current nav item, primary badge", "fg": "primary-700", "bg": "primary-50", "kind": "text" },
    { "use": "Pro badge, selected answer text, Pro panel body", "fg": "primary-800", "bg": "primary-50", "kind": "text" },
    { "use": "Pro panel title", "fg": "primary-900", "bg": "primary-50", "kind": "text" },
    { "use": "Avatar initials", "fg": "primary-800", "bg": "primary-100", "kind": "text" },
    { "use": "Body text on selected card / option tile", "fg": "ink-900", "bg": "primary-50", "kind": "text" },
    { "use": "Neutral badge", "fg": "ink-700", "bg": "ink-100", "kind": "text" },
    { "use": "Free badge", "fg": "accent-900", "bg": "accent-100", "kind": "text" },
    { "use": "Text on the logo cyan", "fg": "ink-900", "bg": "accent-300", "kind": "text" },
    { "use": "Accent text (dark cyan) on white", "fg": "accent-700", "bg": "surface", "kind": "text" },
    { "use": "Success text, positive delta", "fg": "success-700", "bg": "surface", "kind": "text" },
    { "use": "Success badge / alert, correct answer text", "fg": "success-800", "bg": "success-50", "kind": "text" },
    { "use": "Correct option letter", "fg": "white", "bg": "success-700", "kind": "text" },
    { "use": "Warning text", "fg": "warning-700", "bg": "surface", "kind": "text" },
    { "use": "Warning badge / alert", "fg": "warning-800", "bg": "warning-50", "kind": "text" },
    { "use": "Error text, negative delta, field error", "fg": "danger-700", "bg": "surface", "kind": "text" },
    { "use": "Error badge / alert, wrong answer text", "fg": "danger-800", "bg": "danger-50", "kind": "text" },
    { "use": "Danger button, wrong option letter", "fg": "white", "bg": "danger-600", "kind": "text" },
    { "use": "Danger button hover", "fg": "white", "bg": "danger-700", "kind": "text" },
    { "use": "Info text", "fg": "info-700", "bg": "surface", "kind": "text" },
    { "use": "Info badge / alert", "fg": "info-800", "bg": "info-50", "kind": "text" },
    { "use": "Tooltip", "fg": "white", "bg": "ink-900", "kind": "text" },
    { "use": "Score display (36-48px)", "fg": "ink-900", "bg": "surface", "kind": "large" },
    { "use": "Control border (input, select, secondary button)", "fg": "ink-500", "bg": "surface", "kind": "nontext" },
    { "use": "Focus ring", "fg": "primary-500", "bg": "surface", "kind": "nontext" },
    { "use": "Focus ring on page background", "fg": "primary-500", "bg": "ink-50", "kind": "nontext" },
    { "use": "Switch track (off)", "fg": "ink-500", "bg": "surface", "kind": "nontext" },
    { "use": "Switch thumb on track (off)", "fg": "white", "bg": "ink-500", "kind": "nontext" },
    { "use": "Switch track (on), selected option border", "fg": "primary-600", "bg": "surface", "kind": "nontext" },
    { "use": "Progress fill on track", "fg": "primary-600", "bg": "ink-200", "kind": "nontext" },
    { "use": "Correct-answer border / icon", "fg": "success-600", "bg": "surface", "kind": "nontext" },
    { "use": "Wrong-answer border / icon", "fg": "danger-600", "bg": "surface", "kind": "nontext" },
    { "use": "Warning icon", "fg": "warning-700", "bg": "warning-50", "kind": "nontext" },
    { "use": "Not-started topic icon", "fg": "ink-500", "bg": "surface", "kind": "nontext" },
    { "use": "Logo cyan on white: decorative only, never text", "fg": "accent-300", "bg": "surface", "kind": "decorative" },
    { "use": "Disabled control label", "fg": "ink-600", "bg": "ink-200", "kind": "disabled" },
    { "use": "Disabled text (ink-400)", "fg": "ink-400", "bg": "surface", "kind": "disabled" }
  ]
}
