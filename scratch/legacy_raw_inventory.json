        "category_id": "26d8b7da-ea3c-4ed9-a04e-b55124d737dc",
        "section_name": null,
        "topic": "Error Spotting",
        "difficulty": "medium",
        "question_text": "निम्नलिखित में से वाक्यों के समूह का सत्य रूप बताइए:",
        "options": {
          "A": "भारत में अनेकों जातियाँ हैं।",
          "B": "भारत में अनेकों जाति हैं।",
          "C": "भारत में अनेक जातियाँ हैं।",
          "D": "भारत में अनेक जातिहैं।"
        },
        "correct_answer": "C",
        "explanation": "'अनेक' के साथ 'ों' नहीं लगता और बहुवचन 'जातियाँ' सही है।",
