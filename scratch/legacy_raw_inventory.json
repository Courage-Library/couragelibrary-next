        "section_name": null,
        "topic": "Parts of Speech (शब्द भेद)",
        "difficulty": "medium",
        "question_text": "किस वाक्य में 'अच्छा' शब्द का प्रयोग विशेषण के रूप में हुआ है?",
        "options": {
          "A": "अच्छा, तुम अभी आए।",
          "B": "यह स्थान बहुत अच्छा है।",
          "C": "अच्छा, कुछ मत जाओ।",
