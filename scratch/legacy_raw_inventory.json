        "section_name": null,
        "topic": "Gender (लिंग)",
        "difficulty": "easy",
        "question_text": "निम्नलिखित में से कौन-सा शब्द पुल्लिंग है?",
        "options": {
          "A": "रीति",
          "B": "घटना",
          "C": "क्षेत्र",
          "D": "क्षमा"
        },
        "correct_answer": "C",
        "explanation": "'क्षेत्र' पुल्लिंग शब्द है। रीति, घटना और क्षमा स्त्रीलिंग हैं।",
        "is_active": true,
        "created_at": "2026-04-25T18:26:34.347528",
        "pattern_section_id": "a75648d6-8ca3-4150-b603-98069b573738",
