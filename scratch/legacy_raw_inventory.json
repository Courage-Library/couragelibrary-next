        "id": "39270b27-9dcd-4987-93ab-c14976b3ee9e",
        "category_id": "26d8b7da-ea3c-4ed9-a04e-b55124d737dc",
        "section_name": null,
        "topic": "Synonyms",
        "difficulty": "medium",
        "question_text": "'अनावर्त' शब्द का समभिन्नार्थक क्या है?",
        "options": {
          "A": "निरादर",
          "B": "अयोग्य आचरण",
          "C": "पृथ्वी",
          "D": "न दोहराया हुआ"
        },
        "correct_answer": "D",
        "explanation": "'अनावर्त' का अर्थ है जो दोबारा न आए या न दोहराया गया हो।",
        "is_active": true,
        "created_at": "2026-04-25T18:26:34.347528",
        "pattern_section_id": "a75648d6-8ca3-4150-b603-98069b573738",
