        "section_name": null,
        "topic": "Punctuation (विराम चिह्न)",
        "difficulty": "easy",
        "question_text": "विस्मयबोधक चिह्न है:",
        "options": {
          "A": "(!)",
          "B": "(–)",
          "C": "(>)",
          "D": "(.)"
